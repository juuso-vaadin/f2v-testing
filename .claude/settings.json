{
  "enabledPlugins": {
    "vaadin-skills@vaadin-marketplace": true,
    "vaadin-agent-tools@vaadin-marketplace": true
  },
  "extraKnownMarketplaces": {
    "vaadin-marketplace": {
      "source": {
        "source": "github",
        "repo": "vaadin/agent-marketplace"
      }
    }
  },
  "enabledMcpjsonServers": [
    "vaadin",
    "playwright",
    "figma"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
